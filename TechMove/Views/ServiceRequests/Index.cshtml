@model IReadOnlyList<TechMove.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service requests";
}

<h2>Service requests</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Raise service request</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Contract</th>
            <th>Client</th>
            <th>Description</th>
            <th>USD</th>
            <th>ZAR</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sr in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@sr.ServiceRequestId">@sr.ServiceRequestId</a>
                </td>
                <td>@sr.ContractId</td>
                <td>@(sr.Contract?.Client?.ClientName ?? "—")</td>
                <td>@sr.Description</td>
                <td>@sr.CostUsd</td>
                <td>@sr.CostZar</td>
                <td>@sr.Status</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@sr.ServiceRequestId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@sr.ServiceRequestId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>