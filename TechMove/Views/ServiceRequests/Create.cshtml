@model TechMove.Models.ViewModel.ServiceRequestCreateViewModel

@{
    ViewData["Title"] = "Create Service Request";
}

<h2>Create Service Request</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="ContractId" class="form-label"></label>
        <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId"></select>
        <span asp-validation-for="ContractId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CostUsd" class="form-label"></label>
        <input asp-for="CostUsd" class="form-control" id="costUsdInput" />
        <span asp-validation-for="CostUsd" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Current USD -> ZAR Rate</label>
        <input class="form-control" id="rateOutput" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Estimated Local Cost (ZAR)</label>
        <input class="form-control" id="costZarOutput" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" readonly placeholder="Select a contract" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <button type="submit" id="saveBtn" class="btn btn-primary">Save Service Request</button>
    <p id="inactiveWarning" class="text-danger" style="display:none;">
        Service requests can only be saved when the contract status is Active.
    </p>

    <script>
        (function () {
            // Wait for the DOM to be ready
            document.addEventListener("DOMContentLoaded", function() {
                const jsonEl = document.getElementById("contract-status-json");
                const select = document.getElementById("ContractId");
                const statusInput = document.getElementById("Status");
                const saveBtn = document.getElementById("saveBtn");
                const warn = document.getElementById("inactiveWarning");

                if (!jsonEl || !select || !statusInput) return;

                const statusById = JSON.parse(jsonEl.textContent || "{}");

                function updateUI() {
                    const id = select.value;
                    const status = (id && statusById[id]) ? statusById[id] : "";

                    // Update the read-only Status field
                    statusInput.value = status;

                    // Handle the Save button state
                    const isActive = status.toLowerCase() === "active";
                    if (saveBtn) saveBtn.disabled = !isActive;
                    if (warn) warn.style.display = isActive ? "none" : "block";
                }

                select.addEventListener("change", updateUI);
                updateUI(); // Run once on load
            });
        })();
    </script>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const usdInput = document.getElementById("costUsdInput");
        const rateOutput = document.getElementById("rateOutput");
        const zarOutput = document.getElementById("costZarOutput");

        let debounceTimer;

        usdInput.addEventListener("input", () => {
            clearTimeout(debounceTimer);

            const usd = parseFloat(usdInput.value);
            if (Number.isNaN(usd) || usd < 0) {
                rateOutput.value = "";
                zarOutput.value = "";
                return;
            }

            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/Currency/UsdToZarEstimate?usd=${encodeURIComponent(usd)}`);
                    if (!res.ok) throw new Error("Unable to get exchange rate.");

                    const data = await res.json();
                    rateOutput.value = data.rate;
                    zarOutput.value = data.zar;
                } catch {
                    rateOutput.value = "Error";
                    zarOutput.value = "Error";
                }
            }, 350);
        });
    </script>

    <script type="application/json" id="contract-status-json">
        @Html.Raw(ViewBag.ContractStatusByIdJson)
    </script>
}