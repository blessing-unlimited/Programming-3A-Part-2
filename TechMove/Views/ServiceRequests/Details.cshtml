@model TechMove.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Request Details";
}

<h2>Service Request Details</h2>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.ServiceRequestId</dd>

    <dt class="col-sm-3">Contract</dt>
    <dd class="col-sm-9">@Model.ContractId</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">USD Cost</dt>
    <dd class="col-sm-9">@Model.CostUsd</dd>

    <dt class="col-sm-3">Rate (USD->ZAR)</dt>
    <dd class="col-sm-9">@Model.ExchangeRateUsdToZar</dd>

    <dt class="col-sm-3">Local Cost (ZAR)</dt>
    <dd class="col-sm-9">@Model.CostZar</dd>

    <dt class="col-sm-3">Rate Fetched (UTC)</dt>
    <dd class="col-sm-9">@Model.ExchangeRateFetchedAtUtc</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>