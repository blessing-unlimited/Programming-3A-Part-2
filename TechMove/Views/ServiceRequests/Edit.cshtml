@model TechMove.Models.ViewModel.ServiceRequestCreateViewModel

@{
    ViewData["Title"] = "Edit Service Request";
}

<h1>Edit Service Request</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ServiceRequestId" />

            <div class="mb-3">
                <label asp-for="ContractId" class="form-label">Contract</label>
                <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId"></select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label"></label>
                <input asp-for="CostUsd" class="form-control" id="costUsdInput" />
                <span asp-validation-for="CostUsd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <input asp-for="Status" class="form-control" readonly />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" id="saveBtn" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

            <p id="inactiveWarning" class="text-danger" style="display:none;">
                Service requests can only be saved when the contract status is Active.
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="contract-status-json">
        @Html.Raw(ViewBag.ContractStatusByIdJson)
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const jsonEl = document.getElementById("contract-status-json");
            const select = document.getElementById("ContractId");
            const statusInput = document.querySelector('input[name="Status"]');
            const saveBtn = document.getElementById("saveBtn");
            const warn = document.getElementById("inactiveWarning");

            if (!jsonEl || !select || !statusInput) return;

            const statusById = JSON.parse(jsonEl.textContent || "{}");

            function updateUI() {
                const id = select.value;
                const status = (id && statusById[id]) ? statusById[id] : "";
                statusInput.value = status;

                const isActive = status.toLowerCase() === "active";
                if (saveBtn) saveBtn.disabled = !isActive;
                if (warn) warn.style.display = isActive ? "none" : "block";
            }

            select.addEventListener("change", updateUI);
            updateUI();
        });
    </script>
}