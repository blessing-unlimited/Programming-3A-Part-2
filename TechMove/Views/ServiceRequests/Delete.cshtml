@model TechMove.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<h1>Delete Service Request</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this service request?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">Request ID</dt>
        <dd class="col-sm-9">@Model.ServiceRequestId</dd>

        <dt class="col-sm-3">Contract ID</dt>
        <dd class="col-sm-9">@Model.ContractId</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Cost (USD)</dt>
        <dd class="col-sm-9">@Model.CostUsd</dd>

        <dt class="col-sm-3">Cost (ZAR)</dt>
        <dd class="col-sm-9">@Model.CostZar</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ServiceRequestId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>