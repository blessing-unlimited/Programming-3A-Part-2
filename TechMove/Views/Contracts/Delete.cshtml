@model TechMove.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<h1>Delete Contract</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this contract?</h3>
    <p>This will also delete any associated service requests.</p>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">Contract ID</dt>
        <dd class="col-sm-9">@Model.ContractId</dd>

        <dt class="col-sm-3">Client</dt>
        <dd class="col-sm-9">@(Model.Client?.ClientName ?? "—")</dd>

        <dt class="col-sm-3">Start Date</dt>
        <dd class="col-sm-9">@Model.StartDate</dd>

        <dt class="col-sm-3">End Date</dt>
        <dd class="col-sm-9">@Model.EndDate</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ContractId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>