@model TechMove.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<h2>Contract Details</h2>

<dl class="row">
    <dt class="col-sm-3">Contract ID</dt>
    <dd class="col-sm-9">@Model.ContractId</dd>

    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.Client?.ClientName (@Model.ClientId)</dd>

    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.StartDate</dd>

    <dt class="col-sm-3">End Date</dt>
    <dd class="col-sm-9">@Model.EndDate</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Service Level</dt>
    <dd class="col-sm-9">@Model.ServiceLevel</dd>

    <dt class="col-sm-3">Agreement Upload Date</dt>
    <dd class="col-sm-9">@Model.AgreementUploadDate</dd>

    <dt class="col-sm-3">Agreement File</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrWhiteSpace(Model.SignedAgreementPath))
        {
            <a href="/@Model.SignedAgreementPath" target="_blank">@Model.SignedAgreementFileName</a>
        }
        else
        {
            <span>No file uploaded</span>
        }
    </dd>
</dl>