@model TechMove.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<h1>Delete Client</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this?</h3>
    <p>Deleting this client will also delete all associated contracts and service requests.</p>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ClientName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ClientName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ContactDetails)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactDetails)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Region)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Region)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ClientId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>